# Copy this file to .env and keep the real file private.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ENABLED=0

DB_PATH=./vps/jobs.db
# Local-only by default. Setup offers 0.0.0.0 for trusted-network access.
API_HOST=127.0.0.1
API_PORT=8787
# auto opens the browser for interactive launches; set 0 for headless systems.
OPEN_WEB_UI=auto
VPS_URL=http://127.0.0.1:8787

OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3-14b-64k
OLLAMA_TIMEOUT=120
COMFY_URL=http://127.0.0.1:8188
# Optional path to the ComfyUI directory containing main.py.
COMFYUI_PATH=
# Optional shared model destination for setup; must already be configured in ComfyUI.
COMFY_MODELS_DIR=
# Optional overrides for CPU identity-background isolation used by anchored
# multi-character images. The model defaults to ./models/u2net_human_seg.onnx;
# set these when the model or ComfyUI Python lives elsewhere.
COMFY_PYTHON=
IDENTITY_SEGMENTATION_MODEL=./models/u2net_human_seg.onnx

PEAK_HOURS_GATE=0
WORKER_ENABLED=1
VIDEO_START_DELAY_SECONDS=5
# Set 0 to restore the earlier behavior where an in-progress clothing-removal
# action could satisfy a completed reveal request.
CASTWORKSHOP_COMPLETED_MEDIA_REQUIREMENTS=1
# Optional explicit FFmpeg executable path for video continuation.
FFMPEG_PATH=
