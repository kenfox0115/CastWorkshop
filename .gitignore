# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.coverage
htmlcov/

# .env files hold local secrets (telegram token, etc). NEVER track these.
.env
.env.*
!.env.example

# Hermes / runtime state
logs/
*.log
.video_monitor_state.json

# Media output
voice_preview/
output/
*.safetensors
*.ckpt
*.gguf
*.onnx
*.pth
*.pt

# Local venv (aider)
.aider-venv/
.aider_test/
# Project venv (setup_project.py target) — never commit a venv
.venv/
# SQLite databases (runtime state, not source)
*.db
*.db-journal
*.db-wal
*.db-shm
.aider*
.hermes/

# Editors and operating-system metadata
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Private handoff docs (role briefs for non-coding agents) — never public
handoff/

# Application-owned generated media
data/media/

# Clean release candidates and archives generated by scripts/build_release.py
releases/

# Installed engines, model caches, and release build metadata
/ComfyUI/
/models/
/third_party/
/release_manifest.json
*.zip
*.zip.sha256
*.review.json

# Internal release preparation notes (retain local copies)
/docs/PRE_RELEASE_REVIEW.md
/docs/GITHUB_UPLOAD.md
